# ═══════════════════════════════════════════════════════════════════
# SANTÉ SÉNÉGAL - Variables d'environnement
# Copie ce fichier en .env et remplace les valeurs
# ═══════════════════════════════════════════════════════════════════

# ─── Environnement ────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_VERSION=v1
APP_NAME="Santé Sénégal"
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# ─── Base de données PostgreSQL ───────────────────────────────────
DATABASE_URL="postgresql://sante_user:CHANGE_ME_PASSWORD@localhost:5432/sante_senegal?schema=public"

# ─── Redis (cache + queues) ───────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ─── JWT Authentication ───────────────────────────────────────────
JWT_SECRET=CHANGE_ME_USE_LONG_RANDOM_STRING_AT_LEAST_64_CHARS
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=CHANGE_ME_USE_DIFFERENT_LONG_RANDOM_STRING
JWT_REFRESH_EXPIRES_IN=30d

# ─── Bcrypt ───────────────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=12

# ─── OTP ──────────────────────────────────────────────────────────
OTP_EXPIRES_IN_MINUTES=5
OTP_MAX_ATTEMPTS=5

# ─── SMS - Twilio ─────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ─── SMS - Orange Sénégal ─────────────────────────────────────────
ORANGE_SMS_CLIENT_ID=
ORANGE_SMS_CLIENT_SECRET=
ORANGE_SMS_SENDER_NAME=SanteSn

# ─── Paiements - Wave Business ────────────────────────────────────
WAVE_API_KEY=
WAVE_API_SECRET=
WAVE_WEBHOOK_SECRET=

# ─── Paiements - Orange Money ─────────────────────────────────────
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_MERCHANT_KEY=

# ─── Cloudinary (stockage fichiers) ───────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Mapbox (géolocalisation) ─────────────────────────────────────
MAPBOX_ACCESS_TOKEN=

# ─── Firebase Cloud Messaging (push notifications) ────────────────
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# ─── Rate Limiting ────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ─── CORS ─────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:5500

# ─── Logging ──────────────────────────────────────────────────────
LOG_LEVEL=debug
LOG_DIRECTORY=./logs

# ─── Sentry (monitoring) ──────────────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# ─── Téléconsultation vidéo (Daily.co) ────────────────────────────
# Laisser vide en dev pour utiliser le provider MOCK (aucun service externe)
DAILY_API_KEY=
DAILY_DOMAIN=
